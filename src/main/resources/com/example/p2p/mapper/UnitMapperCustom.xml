<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.p2p.mapper.UnitMapperCustom">
  <select id="selectUnitOptions" resultType="com.example.p2p.dto.admin.UnitOptionDto">
    select
      unit_id,
      name
    from unit
    order by name asc;

  </select>
</mapper>
