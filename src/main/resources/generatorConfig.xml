<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN" "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>
  <context id="PostgresTables" targetRuntime="MyBatis3">
    <!-- MapperにMapperアノテーションを付与 -->
    <plugin
      type="org.mybatis.generator.plugins.MapperAnnotationPlugin" />


    <!-- TODO PWとID別の場所へ -->
    <!-- スキーマ情報を取得する DB への接続設定 -->
    <jdbcConnection driverClass="org.postgresql.Driver"
      connectionURL="jdbc:postgresql://localhost/p2p" userId="postgres"
      password="softeni0926">
    </jdbcConnection>

    <javaTypeResolver>
      <property name="useJSR310Types" value="true" />
    </javaTypeResolver>

    <!-- SELECT 結果等を格納するドメインモデルを生成する設定 -->
    <javaModelGenerator
      targetPackage="com.example.p2p.entity"
      targetProject="src/main/java">
      <property name="enableSubPackages" value="false" />
      <property name="trimStrings" value="false" />
    </javaModelGenerator>

    <!-- SQL 設定が記述された XML を生成する設定 -->
    <sqlMapGenerator
      targetPackage="com.example.p2p.mapper"
      targetProject="src/main/resources">
      <property name="enableSubPackages" value="false" />
    </sqlMapGenerator>
    <!-- マッパークラスを生成する設定 -->
    <javaClientGenerator type="XMLMAPPER"
      targetPackage="com.example.p2p.mapper"
      targetProject="src/main/java">
      <property name="enableSubPackages" value="false" />
    </javaClientGenerator>

    <!-- コードを生成するテーブルを指定 -->
    <table tableName="users"></table>
    <table tableName="unit"></table>
    <table tableName="payment_term">
      <columnOverride column="due_date_type" jdbcType="VARCHAR" javaType="com.example.p2p.enums.DueDateType"
        typeHandler="org.apache.ibatis.type.EnumTypeHandler">
      </columnOverride>
    </table>
    <table tableName="supplier"></table>
    <table tableName="item">
      <columnOverride column="kind" jdbcType="VARCHAR" javaType="com.example.p2p.enums.ItemKind"
        typeHandler="org.apache.ibatis.type.EnumTypeHandler">
      </columnOverride>
    </table>
    <table tableName="role">
      <columnOverride column="pr_view_scope" jdbcType="VARCHAR" javaType="com.example.p2p.enums.VisibilityScope"
        typeHandler="org.apache.ibatis.type.EnumTypeHandler">
      </columnOverride>
      <columnOverride column="po_view_scope" jdbcType="VARCHAR" javaType="com.example.p2p.enums.VisibilityScope"
        typeHandler="org.apache.ibatis.type.EnumTypeHandler">
      </columnOverride>
      <columnOverride column="receipt_view_scope" jdbcType="VARCHAR" javaType="com.example.p2p.enums.VisibilityScope"
        typeHandler="org.apache.ibatis.type.EnumTypeHandler">
      </columnOverride>
      <columnOverride column="invoice_view_scope" jdbcType="VARCHAR" javaType="com.example.p2p.enums.VisibilityScope"
        typeHandler="org.apache.ibatis.type.EnumTypeHandler">
      </columnOverride>
    </table>
    <table tableName="user_invitation_token"></table>
    <table tableName="purchase_request">
      <columnOverride column="status" jdbcType="VARCHAR" javaType="com.example.p2p.enums.PurchaseRequestStatus"
        typeHandler="org.apache.ibatis.type.EnumTypeHandler">
      </columnOverride>
    </table>
    <table tableName="email_change_request"></table>
    <table tableName="purchase_request_detail">
      <columnOverride column="snap_kind" jdbcType="VARCHAR" javaType="com.example.p2p.enums.ItemKind"
        typeHandler="org.apache.ibatis.type.EnumTypeHandler">
      </columnOverride>
    </table>
    <table tableName="approval_workflow">
      <columnOverride column="document_type" jdbcType="VARCHAR" javaType="com.example.p2p.enums.DocumentType"
        typeHandler="org.apache.ibatis.type.EnumTypeHandler">
      </columnOverride>
    </table>
    <table tableName="approval_step"></table>
    <table tableName="approval_step_approver"></table>

  </context>
</generatorConfiguration>
